geom_line(color = "steelblue", linewidth = 1) +
geom_point(color = "darkblue", size = 2) +
labs(title = paste("Station:", station_name, "- Annual Max Flow (1946-2012)"),
x = "Year", y = "Max Flow") +
theme_minimal()
print(ts_plot)
