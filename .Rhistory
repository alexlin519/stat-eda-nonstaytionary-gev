ydat = covariate_matrix
# ==============================================================================
# 2. CORE ANALYSIS FUNCTION
# ==============================================================================
# This function allows you to process any specific station you want.
run_gev_analysis <- function(station_name, data) {
# Load Required Libraries
library(dplyr)
library(ggplot2)
library(ismev)      # For GEV fitting and diagnostics
library(extRemes)   # ONLY for the Return Level plot
library(leaflet)    # For the station map
# ==============================================================================
# 1. MAP OF THE STATIONS
# ==============================================================================
# Grabbing the first 10 unique stations for our loop later
target_stations <- unique(sf_hist$Station)[1:10]
# Extract coordinates and plot map
station_coords <- sf_hist %>%
filter(Station %in% target_stations) %>%
group_by(Station) %>%
summarize(Longitude = first(Longitude), Latitude = first(Latitude))
leaflet(data = station_coords) %>%
addProviderTiles(providers$CartoDB.Positron) %>%
addCircleMarkers(
~Longitude, ~Latitude, label = ~Station,
radius = 6, color = "darkblue", fillOpacity = 0.8, stroke = FALSE
)
# ==============================================================================
# 2. CORE ANALYSIS FUNCTION
# ==============================================================================
# This function allows you to process any specific station you want.
run_gev_analysis <- function(station_name, data) {
cat("\n======================================================\n")
cat("ANALYSIS FOR STATION:", station_name, "\n")
cat("======================================================\n")
# --- Data Pre-processing ---
stn_data <- data %>% filter(Station == station_name)
stn_data <- stn_data %>% filter(Year > 1945) # Get rid of first year (incomplete)
stn_data <- na.omit(stn_data)
stn_data$Year_centered <- stn_data$Year - mean(stn_data$Year)
# --- Time Series Plot ---
ts_plot <- ggplot(stn_data, aes(x = Year, y = MaxFlow)) +
geom_line(color = "steelblue", linewidth = 1) +
geom_point(color = "darkblue", size = 2) +
labs(title = paste("Station", station_name, ": Annual Max Flow Time Series"),
x = "Year", y = "Max Flow") +
theme_minimal()
print(ts_plot)
# --- STATIONARY MODEL (ismev) ---
cat("\n--- STATIONARY MODEL ---\n")
# ismev prints optimization details by default; we capture the fit object
fit_stat <- gev.fit(stn_data$MaxFlow)
# Estimates and Standard Errors
est <- fit_stat$mle
se  <- fit_stat$se
names(est) <- names(se) <- c("Location (mu)", "Scale (sigma)", "Shape (xi)")
cat("\nParameter Estimates:\n")
print(round(est, 4))
cat("\nStandard Errors:\n")
print(round(se, 4))
# Correlation Matrix
cat("\nCorrelation Matrix:\n")
corr_matrix <- cov2cor(fit_stat$cov)
rownames(corr_matrix) <- colnames(corr_matrix) <- c("mu", "sigma", "xi")
print(round(corr_matrix, 4))
# --- DELTA METHOD FOR RETURN LEVEL (Stationary) ---
# We will calculate the 50-year return level as an example
T_year <- 50
p <- 1 / T_year
y <- -log(1 - p)
mu  <- est[1]
sig <- est[2]
xi  <- est[3]
# 1. Point Estimate for Return Level
zp <- mu - (sig / xi) * (1 - y^(-xi))
# 2. Partial Derivatives (Gradient vector)
dz_dmu <- 1
dz_dsig <- -(1 / xi) * (1 - y^(-xi))
dz_dxi <- (sig / xi^2) * (1 - y^(-xi)) - (sig / xi) * y^(-xi) * log(y)
grad <- c(dz_dmu, dz_dsig, dz_dxi)
# 3. Delta Method Standard Error
# SE = sqrt( gradient^T * CovarianceMatrix * gradient )
V <- fit_stat$cov
se_zp <- sqrt(t(grad) %*% V %*% grad)
# 4. 95% Confidence Interval
ci_lower <- zp - 1.96 * se_zp
ci_upper <- zp + 1.96 * se_zp
cat(sprintf("\n%d-Year Return Level: %.2f\n", T_year, zp))
cat(sprintf("Delta Method SE: %.2f\n", se_zp))
cat(sprintf("95%% CI: [%.2f,  %.2f]\n", ci_lower, ci_upper))
# --- DIAGNOSTIC PLOTS (ismev) ---
# This generates the 4 standard diagnostic plots (Prob, QQ, Density, Return Level)
gev.diag(fit_stat)
# --- EXT-REMES RETURN LEVEL PLOT (As requested) ---
# We fit silently with extRemes ONLY to utilize its return level plot engine
fit_ext <- fevd(stn_data$MaxFlow, type = "GEV")
fit_ext$call <- NULL # Scrubs the text from the top of the plot
plot(fit_ext, type = "rl", main = paste("extRemes Return Level Plot:", station_name))
# --- NON-STATIONARY MODEL (ismev) ---
cat("\n--- NON-STATIONARY MODEL (Linear Trend on Mu and Sigma) ---\n")
# In ismev, we pass the covariate matrix to 'ydat' and specify which parameters
# take the covariate via mul (mu linear) and sigl (sigma linear).
covariate_matrix <- as.matrix(stn_data$Year_centered)
fit_ns <- gev.fit(xdat = stn_data$MaxFlow,
ydat = covariate_matrix,
mul = 1,   # Location parameter is a linear function of col 1
sigl = 1)  # Scale parameter is a linear function of col 1
ns_est <- fit_ns$mle
ns_se  <- fit_ns$se
names(ns_est) <- names(ns_se) <- c("mu0 (Intercept)", "mu1 (Trend)",
"sig0 (Intercept)", "sig1 (Trend)", "Shape (xi)")
cat("\nNon-Stationary Estimates:\n")
print(round(ns_est, 4))
cat("\nNon-Stationary Standard Errors:\n")
print(round(ns_se, 4))
# Return the fits invisibly in case you want to save them to an object
invisible(list(Stat = fit_stat, NonStat = fit_ns, Data = stn_data))
}
# ==============================================================================
# 3. HOW TO USE THE SCRIPT
# ==============================================================================
# OPTION A: Run it for one specific station (e.g., "FRSMS")
# If FRSMS is not in the first 10, just type it in manually here.
frsms_results <- run_gev_analysis("FRSMS", sf_hist)
# OPTION B: Loop through the first 10 stations
# Note: You might want to run this loop with par(ask=TRUE) so it pauses
# between plots, or export them to a PDF as we did in the previous iterations.
# par(ask = TRUE) # Uncomment this if you want R to wait for you to click "next plot"
# for (stn in target_stations) {
#   run_gev_analysis(stn, sf_hist)
# }
# par(ask = FALSE)
# Load Required Libraries
library(dplyr)
library(ggplot2)
library(ismev)
# ==============================================================================
# CORE ANALYSIS FUNCTION
# ==============================================================================
run_gev_analysis <- function(station_name, data) {
cat("\n======================================================\n")
cat("ANALYSIS FOR STATION:", station_name, "\n")
cat("======================================================\n")
# ---------------------------------------------------------
# PRE-PROCESSING
# ---------------------------------------------------------
# Filter for the specific station
stn_data <- data %>% filter(Station == station_name)
# Remove the year 1945 and keep data only up to 2012
stn_data <- stn_data %>% filter(Year > 1945 & Year <= 2012)
stn_data <- na.omit(stn_data)
# ---------------------------------------------------------
# ORDER 1: TIME SERIES PLOT
# ---------------------------------------------------------
ts_plot <- ggplot(stn_data, aes(x = Year, y = MaxFlow)) +
geom_line(color = "steelblue", linewidth = 1) +
geom_point(color = "darkblue", size = 2) +
labs(title = paste("Station:", station_name, "- Annual Max Flow (1946-2012)"),
x = "Year", y = "Max Flow") +
theme_minimal()
print(ts_plot)
# ---------------------------------------------------------
# ORDER 2: FIT GEV & DIAGNOSTIC PLOTS
# ---------------------------------------------------------
# We use show = FALSE to suppress the messy optimization text in the console
fit_stat <- gev.fit(stn_data$MaxFlow, show = FALSE)
# Set up an outer margin to force a master title onto the ismev plot grid
par(oma = c(0, 0, 3, 0))
# Generate the 4 diagnostic plots
gev.diag(fit_stat)
# Stamp the Station Name at the very top of the diagnostic plots
mtext(paste("Station:", station_name, "- GEV Diagnostic Plots"),
outer = TRUE, cex = 1.5, font = 2)
# Reset margins back to normal
par(oma = c(0, 0, 0, 0))
# ---------------------------------------------------------
# ORDER 3: DECENT SUMMARY TABLE (Console Output)
# ---------------------------------------------------------
# Extract estimates and standard errors
est <- fit_stat$mle
se  <- fit_stat$se
# Calculate Correlation Matrix
corr_matrix <- cov2cor(fit_stat$cov)
# Build a unified data frame for a clean console display
summary_table <- data.frame(
Parameter = c("Location (mu)", "Scale (sigma)", "Shape (xi)"),
Estimate  = round(est, 4),
Std_Error = round(se, 4),
Corr_mu   = round(corr_matrix[, 1], 4),
Corr_sig  = round(corr_matrix[, 2], 4),
Corr_xi   = round(corr_matrix[, 3], 4)
)
cat("\n--- Parameter Estimates, Standard Errors, and Correlation Matrix ---\n")
# Print the table cleanly without row numbers
print(summary_table, row.names = FALSE)
cat("--------------------------------------------------------------------\n\n")
# Return the model silently in case you need to save it to a variable
invisible(fit_stat)
}
# ==============================================================================
# HOW TO EXECUTE (OPTION A & B)
# ==============================================================================
# Get the list of the first 10 stations
target_stations <- unique(sf_hist$Station)[1:10]
# --- OPTION A: Run for ONE specific station ---
# run_gev_analysis("FRSMS", sf_hist)
# --- OPTION B: Loop through the 10 stations ---
# If running the loop, R will draw plots very fast. You may want to use par(ask=TRUE)
# so it prompts you to click before moving to the next station's plots.
# par(ask = TRUE)
# for (stn in target_stations) {
#   run_gev_analysis(stn, sf_hist)
# }
# par(ask = FALSE)
# --- OPTION A: Run for ONE specific station ---
run_gev_analysis("FRSMS", sf_hist)
