## Individual Station Analysis

```{r define_function}
# ==============================================================================
# CORE ANALYSIS FUNCTION
# ==============================================================================
run_gev_analysis <- function(station_name, data, stn_index) {
  
  stn_data <- data %>% filter(Station == station_name)
  stn_data <- stn_data %>% filter(Year > 1945 & Year <= 2012)
  stn_data <- na.omit(stn_data)
  
  # ALWAYS VISIBLE: RETURN LEVEL PLOT 
  par(mfrow = c(1, 1)) 
  fit_ext <- fevd(stn_data$MaxFlow, type = "GEV")
  fit_ext$call <- NULL 
  plot(fit_ext, type = "rl", main = paste("Return Level Plot:", station_name))
  
  # START HTML TOGGLE
  cat(paste0("\n\n<details><summary><span style='font-size:1.2em; font-weight:bold; cursor:pointer; color:#2c3e50;'>&#9654; Expand Diagnostics & Details for Station ", stn_index, "</span></summary>\n\n"))
  
  # HIDDEN 1: TIME SERIES PLOT
  ts_plot <- ggplot(stn_data, aes(x = Year, y = MaxFlow)) +
    geom_line(color = "steelblue", linewidth = 1) +
    geom_point(color = "darkblue", size = 2) +
    labs(title = paste("Station:", station_name, "- Annual Max Flow (1946-2012)"),
         x = "Year", y = "Max Flow") +
    theme_minimal()
  
  print(ts_plot)
  cat("\n\n") 
  
  # HIDDEN 2: FIT GEV & DIAGNOSTIC PLOTS
  fit_stat <- gev.fit(stn_data$MaxFlow, show = FALSE)
  
  par(oma = c(0, 0, 3, 0)) 
  gev.diag(fit_stat)
  mtext(paste("Station:", station_name, "- GEV Diagnostic Plots"), 
        outer = TRUE, cex = 1.5, font = 2)
  par(oma = c(0, 0, 0, 0))
  cat("\n\n") 
  
  # HIDDEN 3: SUMMARY TABLE 
  est <- fit_stat$mle
  se  <- fit_stat$se
  corr_matrix <- cov2cor(fit_stat$cov)
  
  summary_table <- data.frame(
    Parameter = c("Location (mu)", "Scale (sigma)", "Shape (xi)"),
    Estimate  = round(est, 4),
    Std_Error = round(se, 4),
    Corr_mu   = round(corr_matrix[, 1], 4),
    Corr_sig  = round(corr_matrix[, 2], 4),
    Corr_xi   = round(corr_matrix[, 3], 4)
  )
  
  cat("<h4>Parameter Estimates, Standard Errors, and Correlation Matrix</h4>\n")
  cat(paste(knitr::kable(summary_table, format = "html", table.attr = "class='table table-striped'"), collapse = "\n"))
  
  # END HTML TOGGLE
  cat("\n\n</details>\n<hr>\n\n")
  
  invisible(fit_stat)
}
```

