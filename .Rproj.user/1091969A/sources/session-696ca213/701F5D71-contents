# Part B — Gridded Baseflow Processing

This is the main script. It produces three outputs per target dataset (`history`, `rcp45`, `rcp85`).

## B.1 — Setup and configuration

```{r grid-setup, eval=FALSE}
library(terra)
library(readr)
library(dplyr)
library(tidyr)
library(arrow)

# Memory governance — keep terra from blowing past 40% of RAM
terraOptions(memmax = 0.4, progress = 10)

# --- SET YOUR TARGET DATASET AND VARIABLE HERE ---
target_dataset <- "rcp45"    # "history", "rcp45", or "rcp85"
variable_name  <- "baseflow"
```

Input NetCDF files:

```{r grid-paths, eval=FALSE}
file_history <- "netCDF_data/Gridded 1945-2012 Baseflow.nc"

files_rcp45 <- c(
  "netCDF_data/CanESM2 RCP45 Baseflow 1945-2099 1.nc",
  "netCDF_data/CanESM2 RCP45 Baseflow 1945-2099 3.nc",
  "netCDF_data/CanESM2 RCP45 Baseflow 1945-2099 2.nc"
)

files_rcp85 <- c(
  "netCDF_data/CanESM2 RCP85 Baseflow 1945-2099 1.nc",
  "netCDF_data/CanESM2 RCP85 Baseflow 1945-2099 3.nc",
  "netCDF_data/CanESM2 RCP85 Baseflow 1945-2099 2.nc"
)

target_files <- switch(target_dataset,
  "history" = file_history,
  "rcp45"   = files_rcp45,
  "rcp85"   = files_rcp85,
  stop("Invalid target_dataset! Use 'history', 'rcp45', or 'rcp85'")
)

spatial_filename <- paste0("daily_bf_", target_dataset, ".tif")
tabular_filename <- paste0("avg_daily_bf_", target_dataset, ".parquet")
```

> **Note on the 3 RCP files.** PCIC ships the long 1945–2099 CanESM2 simulation as multiple NetCDFs; `rast(target_files)` stitches them into a single `SpatRaster` along the time dimension. Verify the date coverage after loading.

## B.2 — Load the raster stack and station coords

```{r grid-load, eval=FALSE}
coords_df <- read_csv("stream_coor_station_hist.csv")

unique_stations <- coords_df %>%
  dplyr::select(Station, Longitude, Latitude) %>%
  distinct()

print(paste("Loading raster data for:", target_dataset))
bf_stack       <- rast(target_files)[toupper(variable_name)]   # subset to BASEFLOW
template_layer <- bf_stack[[1]]
```

## B.3 — Build the 5 × 5 station neighbourhood

For each station, take the grid cell containing it as the **centre**, then expand by two rings of 8-direction adjacency. Ring 1 is the immediate 3 × 3 box (9 cells); ring 2 expands that to 5 × 5 (25 cells). This catches the station's local hydrologic neighbourhood and tolerates small coordinate inaccuracies relative to the 1/16° grid.

```{r grid-neighborhood, eval=FALSE}
print("Mapping 5x5 grid boundaries to stations...")

station_cells_list <- lapply(1:nrow(unique_stations), function(i) {
  pt <- vect(unique_stations[i, ],
             geom = c("Longitude", "Latitude"), crs = "EPSG:4326")

  center_cell <- cells(template_layer, pt)[, "cell"]
  ring_1      <- adjacent(template_layer, center_cell, directions = 8, include = TRUE)
  ring_2      <- adjacent(template_layer, as.vector(ring_1), directions = 8, include = TRUE)

  data.frame(
    Station = unique_stations$Station[i],
    Cell_ID = unique(as.vector(ring_2))
  )
})

station_cell_map <- do.call(rbind, station_cells_list)
keep_cells       <- unique(station_cell_map$Cell_ID)
```

After this step, `station_cell_map` is a long table of `(Station, Cell_ID)` pairs — up to 25 rows per station.

## B.4 — Output 1: Spatial mask → compressed GeoTIFF

Mask the raster stack to keep only the union of neighbourhood cells, crop to the tight bounding box, and write an LZW-compressed multi-band GeoTIFF (one band per day).

```{r grid-output1, eval=FALSE}
print(paste("Generating Output 1:", spatial_filename))

mask_rast <- template_layer
values(mask_rast)   <- NA
mask_rast[keep_cells] <- 1

grid_ext          <- ext(mask_rast, cells = keep_cells)
mask_rast_cropped <- crop(mask_rast, grid_ext)

bf_cropped <- crop(bf_stack, grid_ext)
bf_masked  <- mask(bf_cropped, mask_rast_cropped)

writeRaster(
  bf_masked, spatial_filename,
  filetype = "GTiff",
  gdal     = "COMPRESS=LZW",
  overwrite = TRUE
)
print("Saved Output 1 successfully!")

# Free memory before Output 2
rm(bf_cropped, bf_masked, mask_rast, mask_rast_cropped); gc()
```

## B.5 — Output 2: Top-9 daily mean → Parquet

The representative-baseflow logic: for each station × date, take the **top 9 cells** by baseflow within that station's 5 × 5 neighbourhood and average them. This is more robust than a single grid-point pickup and reduces sensitivity to small registration errors, while still emphasising the high-yield cells that drive station inflow.

Processing is **chunked by 5-year groups** to keep memory usage bounded.

```{r grid-output2, eval=FALSE}
print(paste("Generating Output 2:", tabular_filename))

all_years   <- unique(format(time(bf_stack), "%Y"))
year_groups <- split(all_years, ceiling(seq_along(all_years) / 5))   # 5-year chunks

chunked_results <- list()

for (i in seq_along(year_groups)) {
  current_years <- year_groups[[i]]
  print(paste0("  Chunk ", i, "/", length(year_groups),
               " (Years: ", min(current_years), "-", max(current_years), ")"))

  sub_stack   <- bf_stack[[format(time(bf_stack), "%Y") %in% current_years]]
  chunk_dates <- time(sub_stack)

  # Extract values for every (Station, Cell) pair across this chunk's days
  extracted_mat <- terra::extract(sub_stack, station_cell_map$Cell_ID)
  extracted_df  <- as.data.frame(extracted_mat)
  colnames(extracted_df) <- as.character(chunk_dates)
  extracted_df$Station   <- station_cell_map$Station

  daily_summary <- extracted_df %>%
    pivot_longer(cols = -Station, names_to = "Date", values_to = "Baseflow") %>%
    mutate(Date = as.Date(Date)) %>%
    group_by(Station, Date) %>%
    slice_max(order_by = Baseflow, n = 9, with_ties = FALSE) %>%
    summarize(Rep_Baseflow = mean(Baseflow, na.rm = TRUE), .groups = "drop")

  chunked_results[[i]] <- daily_summary

  rm(sub_stack, extracted_mat, extracted_df, daily_summary); gc()
}

final_tabular_data <- bind_rows(chunked_results)
write_parquet(final_tabular_data, tabular_filename)
print("Saved Output 2 successfully!")
```

**Why Parquet?** Columnar compression handles the (Station × Date) long table well, and reading is much faster than CSV for the join in the next step.

## B.6 — Output 3: Merge baseflow covariate onto streamflow yearly maxima

Pulls the matching `Rep_Baseflow` for each `(Station, MaxDate)` pair from the yearly-maximum streamflow file. This is the table fed into the GEV (Generalised Extreme Value) model.

```{r grid-output3, eval=FALSE}
library(dplyr); library(readr); library(arrow)

# 1. Streamflow filename matches the target
sf_filename <- if (target_dataset == "history") {
  "/Users/alexlin/Downloads/EDA/sf_yearly_max_hist.csv"
} else {
  paste0("/Users/alexlin/Downloads/EDA/sf_yearly_max_", target_dataset, ".csv")
}

# 2. Load
bf_data     <- read_parquet(tabular_filename)
sf_max_data <- read_csv(sf_filename)

# 3. Normalise date types
sf_max_data <- sf_max_data %>% mutate(MaxDate = as.Date(MaxDate))
bf_data     <- bf_data     %>% mutate(Date    = as.Date(Date))

# 4. Join: streamflow row gets the baseflow value from its annual-max date
gev_input_data <- sf_max_data %>%
  left_join(bf_data, by = c("Station" = "Station", "MaxDate" = "Date")) %>%
  rename(Baseflow_Covariate = Rep_Baseflow)

# 5. QC: how many rows failed to find a covariate?
missing_covariates <- sum(is.na(gev_input_data$Baseflow_Covariate))
cat("Rows missing a baseflow covariate after merge:", missing_covariates, "\n")

# 6. Write
merged_output_filename <- paste0("year_", target_dataset, "_sf_bf.csv")
write_csv(gev_input_data, merged_output_filename)
```

The output `year_<target>_sf_bf.csv` is **ready for GEV modelling**: one row per (Station, Year), with annual-max streamflow and the same-day representative baseflow covariate.

